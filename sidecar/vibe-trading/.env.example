# Vibe-Trading sidecar environment. Copy to sidecar/vibe-trading/.env (git-ignored).
# run.sh loads this file and exports it before starting the MCP server.

# ── Sidecar bind ──
VIBE_PORT=8899
VIBE_HOST=127.0.0.1            # keep loopback: the MCP endpoint has NO authentication

# ── LLM (used by swarm runs) — uncomment ONE provider ──
LANGCHAIN_PROVIDER=openrouter
LANGCHAIN_MODEL_NAME=deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LANGCHAIN_TEMPERATURE=0.0
TIMEOUT_SECONDS=120
MAX_RETRIES=2
# Other providers (see Vibe-Trading agent/.env.example): OPENAI_API_KEY, ANTHROPIC_API_KEY,
# DEEPSEEK_API_KEY, GEMINI_API_KEY, GROQ_API_KEY, ...

# ── Data keys (all optional) ──
FRED_API_KEY=                  # required for get_macro_series (free: https://fred.stlouisfed.org/docs/api/api_key.html)
# TUSHARE_TOKEN=
# TICKERALL_API_KEY=           # hosted MT5 forex/metals feed (explicit source="tickerall")

# ── Hardening (leave as is) ──
VIBE_TRADING_ENABLE_SHELL_TOOLS=0   # bash / background_run tools stay OFF
