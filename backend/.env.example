# ── OpenRouter (https://openrouter.ai/keys) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Model riêng cho từng cặp (JSON). Ví dụ dùng model mạnh hơn cho vàng:
# OPENROUTER_SYMBOL_MODELS={"XAUUSD": "anthropic/claude-sonnet-4.5"}
# Danh sách model hiện trong dropdown UI (JSON):
# OPENROUTER_SUGGESTED_MODELS=["google/gemini-2.5-flash","openai/gpt-4.1-mini","anthropic/claude-sonnet-4.5"]

# ── Dữ liệu nến ──
# Yahoo Finance (không cần key) là nguồn chính. Khi Yahoo trả 429, dùng Twelve Data nếu có key
# (đăng ký miễn phí: https://twelvedata.com/pricing — 800 request/ngày).
TWELVEDATA_API_KEY=

# ── Discord ──
# Gia tri duoi day chi la fallback: kenh thong bao that su nam trong backend/notify.yaml
# (cung hinh giong llm.yaml; sua duoc tu trang "Notifications" trong UI).
DISCORD_WEBHOOK_URL=
# ── Telegram (bot + chat id) ──
# Tao bot voi @BotFather, mo chat roi go /start. Chat id lay tu @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_CONFIDENCE=60
NOTIFY_PRE_EVENT=true

# ── Thong bao ──
# NOTIFY_CONFIG=notify.yaml        # duong dan file YAML (mac dinh backend/notify.yaml)
# NOTIFY_MIN_IMPACT=High            # muc impact toi thieu de bao tin moi (High | Medium | Low)
# PRE_EVENT_NOTIFY_MINUTES=10       # bao truoc khi su kien ra may phut (0 = tat)

# ── Thu thập ──
SCHEDULER_ENABLED=true
FF_POLL_MINUTES=10
RSS_POLL_MINUTES=3
# Mặc định: FXStreet news + CNBC Finance. Đã thử 11/2026: forexlive/investinglive 403, investing.com timeout,
# fxempire feed cũ, forexcrunch chỉ còn crypto.
# RSS_FEEDS={"fxstreet": "https://www.fxstreet.com/rss/news", "cnbc": "https://www.cnbc.com/id/10000664/device/rss/rss.html"}
PRE_EVENT_ALERT_MINUTES=30
ANALYZE_MIN_IMPACT=High
AUTO_ANALYZE_HEADLINES=true
MAX_HEADLINE_ANALYSES_PER_CYCLE=5
# WATCH_CURRENCIES=["USD","EUR","GBP","JPY","AUD","NZD","CAD","CHF","XAU"]

# ── Bảo mật / chi phí ──
# Host được phép (chặn DNS rebinding). Thêm hostname nếu chạy qua LAN/Docker/VPS.
# ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Tự phân tích headline: tối đa 1 lần / đồng tiền / N phút
HEADLINE_COOLDOWN_MINUTES=10
# Ngân sách gọi LLM tự động (pre-event + headline) mỗi giờ
MAX_AUTO_LLM_CALLS_PER_HOUR=20
LLM_MAX_TOKENS=4000

# ── Advisor prompt knowledge (vendored Vibe-Trading skills, app/analysis/skills) ──
# Skill frameworks injected into the advisor LLM prompt as background "Reference frameworks".
# Comma-separated; empty (ADVISOR_SKILLS=) disables the section.
# Available: event-driven, geopolitical-risk, global-macro, ichimoku, macro-analysis, sentiment-analysis, smc
# (sentiment-analysis is Chinese/A-share content - not recommended for this FX-focused advisor.)
ADVISOR_SKILLS=global-macro,macro-analysis,event-driven
ADVISOR_SKILLS_MAX_CHARS=2500

# ── Backtest / multi-provider LLM (khong commit key that) ──
# Cau hinh chinh: backend/llm.yaml (mau: llm.ex.yaml; nhieu key/account moi provider, xoay vong). Cac bien duoi day
# la fallback: key khong rong duoc NOI THEM vao danh sach key cua provider, bien dat tuong minh ghi de gia tri trong YAML.
# LLM_CONFIG=llm.yaml
# LLM_DEFAULT_PROVIDER=openrouter
# OPENROUTER_API_KEYS=key2,key3        # them key de xoay vong (OPENROUTER_API_KEY la key dau)
# GROQ_API_KEY=
# HIVE_API_KEY=
# CLAUDE_CODE_BIN=                     # provider claude_code dung Claude CLI da dang nhap, khong can key
# OPENCODE_BIN=                        # provider opencode dung OpenCode CLI (mac dinh: PATH roi ~/.bun/bin/opencode)
# OPENCODE_MODEL=opencode/beam-free
# OPENCODE_THINKING=high
# OPENCODE_TIMEOUT_SECONDS=180
# Cac model so sanh trong backtest, dang <provider>:<model> (JSON):
# BACKTEST_MODELS=["openrouter:google/gemini-2.5-flash","claude_code:claude-haiku-5-5","groq:llama-3.3-70b-versatile"]
# BACKTEST_LLM_MIN_INTERVAL_SECONDS=1
# BACKTEST_MAX_SYMBOLS=3
# BACKTEST_PROMPT_CONTEXT_ITEMS=8      # su kien lien quan TRUOC thoi diem phat hanh dua vao prompt (0 = tat)
# BACKTEST_PROMPT_CONTEXT_HOURS=24

# ── Backtest: lich su headline (app/backtest/headline_history.py) ──
# Nguon khong can key: investinglive sitemap, FXStreet qua web.archive.org, CNBC sitemap, GDELT DOC.
# HEADLINE_HISTORY_ENABLED=true
# HEADLINE_HISTORY_INVESTINGLIVE=true
# HEADLINE_HISTORY_INVESTINGLIVE_FETCH_TITLES=false   # true: doc og:title tung bai (cham hon, tieu de dep hon slug)
# HEADLINE_HISTORY_FXSTREET_WAYBACK=true
# HEADLINE_HISTORY_CNBC=true
# HEADLINE_HISTORY_CNBC_MAX_PAGE_FETCHES=1500
# HEADLINE_HISTORY_GDELT=true
# HEADLINE_HISTORY_GDELT_CHUNK_HOURS=24
# HEADLINE_HISTORY_GDELT_LOOKBACK_DAYS=100   # GDELT chi tra ~3 thang gan nhat; 0 = khong gioi han
# Key tuy chon (de trong = bo qua nguon do):
# HEADLINE_HISTORY_MARKETAUX_API_KEY=      # https://www.marketaux.com (free ~100 request/ngay)
# HEADLINE_HISTORY_FINNHUB_API_KEY=        # https://finnhub.io (free, chi tin gan day)
# HEADLINE_HISTORY_RELEVANT_ONLY=true
# HEADLINE_HISTORY_MAX_TOTAL=20000
# HEADLINE_HISTORY_REQUEST_DELAY_SECONDS=1.0

# ── Xuat / nhap du lieu (trang Data, app/services/datastore.py) ──
# DATA_IMPORT_MAX_MB=500        # file import toi da (MB)
# DATA_BACKUP_KEEP=10           # so ban snapshot tu dong (truoc import / restore) giu lai
# DATA_BACKUP_DIR=              # mac dinh: <thu muc chua fxnews.db>/backups

# ── Long-term memory: Graphiti knowledge graph (app/memory) ──
# Chi luu SU THAT: su kien (title, gio, impact, actual/forecast/previous) + gia thuc te sau su kien (bt_outcomes).
# KHONG BAO GIO luu du doan / bias cua LLM (bt_predictions, analyses, signals, rule_bias).
# Chay Neo4j: docker compose -f docker-compose.memory.yml up -d
# MEMORY_BACKEND=neo4j                 # neo4j | falkordb (falkordb: pip install "graphiti-core[falkordb]")
# MEMORY_NEO4J_URI=bolt://localhost:7687
# MEMORY_NEO4J_USER=neo4j
# MEMORY_NEO4J_PASSWORD=
# MEMORY_EMBEDDER=hash                 # hash (offline, mien phi) | openai (endpoint /embeddings tuong thich OpenAI)
# MEMORY_EMBEDDING_DIM=384             # doi embedder/dim sau nay phai xoa graph va sync lai
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_BASE_URL=
# MEMORY_EMBEDDING_API_KEY=
# MEMORY_INCLUDE_SUMMARY=false         # true: luu ca summary bai bao (co the chua y kien bien tap)

# ── Vibe-Trading sidecar (sidecar/vibe-trading/README.md) ──
# VIBE_ENABLED=false
# VIBE_BASE_URL=http://127.0.0.1:8899
# VIBE_TIMEOUT_SECONDS=600
# VIBE_TOKEN=                      # optional Bearer token (only if a reverse proxy requires it)
# VIBE_ALLOW_CUSTOM_CODE=false     # allow strategy kind "custom" (arbitrary Python executed by the sidecar) - trusted callers only
# VIBE_RUNS_KEEP=30                # newest N nt-* backtest run dirs kept
# ADVISOR_MACRO_ENABLED=false       # add FRED macro snapshot to advisor prompts (needs VIBE_ENABLED=true and FRED_API_KEY on the sidecar)
# ADVISOR_MACRO_TTL_MINUTES=360
# ADVISOR_MACRO_TIMEOUT_SECONDS=8
# VIBE_RUNS_DIR=                   # default: <repo>/sidecar/vibe-trading/runs (must be an allowed run root of the sidecar)
